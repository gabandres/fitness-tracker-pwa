/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      // The barrel only. The wildcard that used to sit here
      // (`"@macrolog/core/*": ["packages/core/src/*"]`) resolved ANY module
      // in the package by path, and a tsconfig `paths` entry beats the
      // package's own `exports` map — so it silently re-opened the deep
      // imports that map exists to restrict. The Angular app has never had a
      // deep import (checked 2026-09-14), so removing it costs nothing here
      // and makes `packages/core/package.json` the single answer to "what may
      // be imported from core" for every consumer. Add a subpath THERE, not
      // here.
      "@macrolog/core": ["packages/core/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
