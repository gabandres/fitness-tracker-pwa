{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; \"$PY\" -c '' 2>/dev/null || PY=python; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_firestore_import.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; \"$PY\" -c '' 2>/dev/null || PY=python; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_firebase_deploy.py\""
          },
          {
            "type": "command",
            "command": "PY=python3; \"$PY\" -c '' 2>/dev/null || PY=python; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_eas_update.py\""
          }
        ]
      }
    ]
  }
}
