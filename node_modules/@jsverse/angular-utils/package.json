{
  "name": "@jsverse/angular-utils",
  "version": "1.0.0-beta.6",
  "license": "MIT",
  "author": "Shahar Kazaz",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/utils.git"
  },
  "peerDependencies": {
    "@angular/compiler": ">=18.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "module": "./index.js",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  }
}