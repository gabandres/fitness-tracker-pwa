<!--
  Quick Settings tile icon.

  A plus in a ring, drawn as a vector so it scales to every QS density, and
  authored as a single filled path with `android:tint` unset: the platform
  tints QS tile icons itself for the on/off state, and a hardcoded colour would
  fight it and render as an unreadable dark-on-dark glyph.

  Lives in the module's own `res/` rather than the app's so the drawable ships
  with the manifest entry that references it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8 8,3.59 8,8 -3.59,8 -8,8zM13,7h-2v4L7,11v2h4v4h2v-4h4v-2h-4z" />
</vector>
