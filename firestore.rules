rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Actors ──────────────────────────────────────────────────
    // Verified-email gate: any provider is allowed (Google, Microsoft,
    // email+password) as long as the email has been verified. Google
    // and Microsoft return verified emails by default; password users
    // must click the verification link before they can write data.
    function isVerifiedUser() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admins (superuser panel). The `admin` custom claim is set by the
    // setAdminClaims Cloud Function. Admins can read pretty much anything
    // from the client for the dashboard; all MUTATIONS still go through
    // Cloud Functions so the audit log + validation can't be skipped.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── Log schema ─────────────────────────────────────────────
    // Required: calories, timestamp
    // Optional: weight, protein, carbs, fat, exerciseCompleted, mealLabel, mealType
    // Legacy (read-only, may exist on historic docs): liftCompleted, cardioCompleted
    function isValidLog(data) {
      return data.keys().hasAll(['calories', 'timestamp'])
          && data.keys().hasOnly([
              'weight', 'calories', 'timestamp',
              'protein', 'carbs', 'fat', 'exerciseCompleted',
              'liftCompleted', 'cardioCompleted',
              'mealLabel', 'mealType'
          ])
          && (!('weight' in data.keys()) ||
              (data.weight is number && data.weight > 0 && data.weight < 1000))
          && data.calories is number
          && data.calories >= 0
          && data.calories < 20000
          && data.timestamp is timestamp
          // Optional fields validated when present
          && (!('protein' in data.keys()) ||
              (data.protein is number && data.protein >= 0 && data.protein < 1000))
          && (!('carbs' in data.keys()) ||
              (data.carbs is number && data.carbs >= 0 && data.carbs < 1000))
          && (!('fat' in data.keys()) ||
              (data.fat is number && data.fat >= 0 && data.fat < 1000))
          && (!('exerciseCompleted' in data.keys()) ||
              data.exerciseCompleted is bool)
          && (!('liftCompleted' in data.keys()) ||
              data.liftCompleted is bool)
          && (!('cardioCompleted' in data.keys()) ||
              data.cardioCompleted is bool)
          && (!('mealLabel' in data.keys()) ||
              (data.mealLabel is string && data.mealLabel.size() <= 100))
          && (!('mealType' in data.keys()) ||
              data.mealType in ['breakfast', 'lunch', 'dinner', 'snack']);
    }

    // ─── Profile schema ─────────────────────────────────────────
    function hasProfileBase(data) {
      // `email` is NO LONGER stored on the profile doc (PII minimization —
      // 2026-07-07): the email lives only in Firebase Auth, so the
      // health-data store is keyed by opaque uid, not identity. Legacy docs
      // may still carry it, so it stays ALLOWED (in the hasOnly lists below)
      // and, when present, must be a string — just no longer REQUIRED.
      return data.keys().hasAll(['createdAt', 'lastSeenAt', 'profileCompleted'])
          && (!('email' in data.keys()) || data.email is string)
          && data.createdAt is timestamp
          && data.lastSeenAt is timestamp
          && data.profileCompleted is bool;
    }

    // ─── In-app feedback ────────────────────────────────────────
    // Written by the mobile composer (UX_AUDIT, Abdiel Medina 2026-08-21:
    // people who would not message the owner directly will leave a note
    // inside the app). Create-only from the client — a user cannot read,
    // edit or delete what they sent, which keeps the record an append-only
    // log rather than something that can be quietly rewritten after the
    // owner has read it.
    //
    // `message` is length-capped HERE and not only in the client, because
    // the client cap is a courtesy and the rule is the control: this is the
    // one collection any authenticated user can add documents to at will.
    // `category` is a closed set with an explicit 'none' rather than an
    // absent field, so an unset chip is still a legitimate submission.
    function isValidFeedback(data) {
      return data.keys().hasOnly([
              'message', 'category', 'createdAt',
              // Context attached silently by the composer, so a report can be
              // reproduced without asking the reporter what they were running.
              'appVersion', 'platform', 'locale'
            ])
          && 'message' in data.keys()
          && data.message is string
          && data.message.size() > 0
          && data.message.size() <= 4000
          && 'createdAt' in data.keys()
          && data.createdAt is timestamp
          && (!('category' in data.keys()) ||
              data.category in ['bug', 'idea', 'confusing', 'other', 'none'])
          && (!('appVersion' in data.keys()) ||
              (data.appVersion is string && data.appVersion.size() <= 40))
          && (!('platform' in data.keys()) ||
              data.platform in ['ios', 'android', 'web'])
          && (!('locale' in data.keys()) ||
              (data.locale is string && data.locale.size() <= 20));
    }

    function isValidProfileInitial(data) {
      return data.keys().hasOnly([
              'email', 'createdAt', 'lastSeenAt', 'profileCompleted',
              // Referral attribution may be present on initial profile
              // create when the user signed up via a friend's ?ref= link.
              // compedUntil + referralRewardGrantedAt are server-only;
              // listed so server-side admin SDK writes still pass keys
              // validation if they merge during early lifecycle.
              'referredBy', 'compedUntil', 'referralRewardGrantedAt',
              // Public profile fields are server-stamped by claimPublicSlug;
              // listed so client reads-then-merges round-trip cleanly.
              'publicSlug', 'publicProfileEnabled', 'publicDisplayName',
              // Weekly digest opt-in (client-writable) + server stamp
              // (server-only, listed for round-trip parity).
              'weeklyDigestOptIn', 'lastWeeklyDigestSentAt',
              // Unit system (food-search portion picker default).
              'unitSystem',
              // Per-user suppress list for the entry-sheet recents row.
              'hiddenRecentLabels',
              // When the user's day starts (ADR-0030). The full history of
              // changes, oldest first — NOT one hour. See the shape check below.
              'dayBoundary',
              // Seeded demo/review account marker (admin SDK only; listed so
              // the client can round-trip a profile that already carries it).
              'syntheticAccount'
          ])
          && hasProfileBase(data)
          && data.profileCompleted == false
          && (!('syntheticAccount' in data.keys()) || data.syntheticAccount is bool)
          && (!('referredBy' in data.keys()) ||
              (data.referredBy is string && data.referredBy.size() >= 20 && data.referredBy.size() <= 40))
          && (!('compedUntil' in data.keys()) || data.compedUntil is timestamp)
          && (!('referralRewardGrantedAt' in data.keys()) || data.referralRewardGrantedAt is timestamp)
          && (!('unitSystem' in data.keys()) ||
              data.unitSystem == 'us' || data.unitSystem == 'metric')
          && (!('hiddenRecentLabels' in data.keys()) ||
              (data.hiddenRecentLabels is list
               && data.hiddenRecentLabels.size() <= 200))
          && (!('dayBoundary' in data.keys()) ||
              (data.dayBoundary is list
               && data.dayBoundary.size() <= 24));
    }

    // ─── Weigh-in date key ──────────────────────────────────────
    // `dailyWeights` doc ids are YYYY-MM-DD. Mirrors isStorableWeighInDate in
    // packages/core/src/weight-bounds.ts.
    //
    // The 2-day slack is deliberate and load-bearing: `request.time` is UTC
    // while the key is the user's LOCAL date, so a user in UTC+13 can
    // legitimately write a key one day ahead of UTC. Comparing against bare
    // UTC "today" would make logging today's weight impossible for them.
    // Two days covers UTC-12..UTC+14 with room and still rejects a mistyped
    // year.
    function isPlausibleWeighInDateKey(dateKey) {
      return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dateKey >= '2000-01-01'
          && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10]))
             <= request.time + duration.value(2, 'd');
    }

    // ─── Measurement schema ─────────────────────────────────────
    function isValidMeasurement(data) {
      return data.keys().hasAll(['timestamp'])
          && data.keys().hasOnly(['timestamp', 'waist', 'chest', 'bicep', 'hip', 'neck'])
          && data.timestamp is timestamp
          && data.keys().size() >= 2
          // Per-field bands in INCHES, mirroring MEASUREMENT_BOUNDS_IN in
          // packages/core/src/measurement-bounds.ts — keep the two in step.
          // One shared 0–200 range let a 15in chest through (a neck value in
          // the chest field); no single range can catch that, because 15 is
          // absurd for a chest and ordinary for a neck.
          && (!('waist' in data.keys()) || (data.waist is number && data.waist >= 15 && data.waist <= 80))
          && (!('chest' in data.keys()) || (data.chest is number && data.chest >= 20 && data.chest <= 80))
          && (!('bicep' in data.keys()) || (data.bicep is number && data.bicep >= 5 && data.bicep <= 30))
          && (!('hip' in data.keys()) || (data.hip is number && data.hip >= 20 && data.hip <= 80))
          && (!('neck' in data.keys()) || (data.neck is number && data.neck >= 8 && data.neck <= 30));
    }

    // ─── Preset schema ────────────────────────────────────────
    function isValidPreset(data) {
      return data.keys().hasAll(['name', 'calories'])
          && data.keys().hasOnly(['name', 'calories', 'protein', 'carbs', 'fat'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100
          && data.calories is number
          && data.calories >= 0
          && data.calories < 20000
          && (!('protein' in data.keys()) ||
              (data.protein is number && data.protein >= 0 && data.protein < 1000))
          && (!('carbs' in data.keys()) ||
              (data.carbs is number && data.carbs >= 0 && data.carbs < 1000))
          && (!('fat' in data.keys()) ||
              (data.fat is number && data.fat >= 0 && data.fat < 1000));
    }

    // ─── Custom food schema (My Foods library, ADR-0013) ────────
    // A portionable, barcode-keyed saved food. Macros are per ONE serving
    // (servingSize + servingUnit); source records the resolution path.
    function isValidCustomFood(data) {
      return data.keys().hasAll(['name', 'calories', 'servingSize', 'servingUnit', 'source', 'createdAt'])
          && data.keys().hasOnly(['name', 'brand', 'barcode', 'servingSize', 'servingUnit',
                                  'calories', 'protein', 'carbs', 'fat', 'source', 'createdAt'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100
          && data.calories is number
          && data.calories >= 0
          && data.calories < 20000
          && data.servingSize is number
          && data.servingSize > 0
          && data.servingSize < 100000
          && data.servingUnit in ['g', 'ml', 'oz', 'piece', 'serving']
          && data.source in ['barcode', 'label', 'text', 'manual']
          && data.createdAt is timestamp
          && (!('brand' in data.keys()) ||
              (data.brand is string && data.brand.size() <= 100))
          && (!('barcode' in data.keys()) ||
              (data.barcode is string && data.barcode.size() <= 32))
          && (!('protein' in data.keys()) ||
              (data.protein is number && data.protein >= 0 && data.protein < 1000))
          && (!('carbs' in data.keys()) ||
              (data.carbs is number && data.carbs >= 0 && data.carbs < 1000))
          && (!('fat' in data.keys()) ||
              (data.fat is number && data.fat >= 0 && data.fat < 1000));
    }

    // ─── Workout schemas ────────────────────────────────────────
    // Owner-scoped data with deeply-nested set/exercise arrays. We
    // validate top-level scalars, list-size caps, and string caps to
    // bound abuse, but trust the owner for nested array contents (same
    // single-user trust model as measurements). All three docs carry
    // server-assigned createdAt/updatedAt; on a merge update,
    // request.resource.data is the POST-write doc so the required
    // stamps remain present and the same validator covers update.
    function isValidExercise(data) {
      return data.keys().hasOnly(['name', 'muscles', 'defaultCues', 'logStyle', 'seedKey', 'createdAt'])
          && data.keys().hasAll(['name', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.createdAt is timestamp
          && (!('muscles' in data.keys()) ||
              (data.muscles is list && data.muscles.size() <= 12))
          && (!('defaultCues' in data.keys()) ||
              (data.defaultCues is list && data.defaultCues.size() <= 30))
          && (!('logStyle' in data.keys()) ||
              (data.logStyle in ['weight-reps', 'bodyweight', 'time']))
          && (!('seedKey' in data.keys()) ||
              (data.seedKey is string && data.seedKey.size() <= 100));
    }

    // `cardioBlocks` is the PRESCRIPTION half of ADR-0025 — cardio a template
    // tells you to do. Optional and absent on every template written before
    // it existed, so it joins hasOnly and NOT hasAll.
    function isValidWorkoutTemplate(data) {
      return data.keys().hasOnly([
              'name', 'notes', 'restMiniSec', 'restClusterSec',
              'exercises', 'cardioBlocks', 'seedKey', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasAll(['name', 'exercises', 'createdAt', 'updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.exercises is list && data.exercises.size() <= 40
          && (!('cardioBlocks' in data.keys()) ||
              (data.cardioBlocks is list && data.cardioBlocks.size() <= 20))
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && (!('notes' in data.keys()) ||
              (data.notes is string && data.notes.size() <= 2000))
          && (!('restMiniSec' in data.keys()) ||
              (data.restMiniSec is number && data.restMiniSec >= 0 && data.restMiniSec <= 3600))
          && (!('restClusterSec' in data.keys()) ||
              (data.restClusterSec is number && data.restClusterSec >= 0 && data.restClusterSec <= 3600))
          && (!('seedKey' in data.keys()) ||
              (data.seedKey is string && data.seedKey.size() <= 100));
    }

    // `cardio` carries the logged cardio blocks (ADR-0025). Like the set/
    // exercise arrays above it, rules validate only that it is a list within a
    // size cap — rules cannot iterate a list, so per-block field validity is
    // the client's job via the packages/core clamps, under the same
    // single-user trust model ADR-0007 established for nested sets.
    //
    // It is in hasOnly but NOT hasAll: a strength-only session has no cardio,
    // and so does every session written before this field existed.
    function isValidWorkoutSession(data) {
      return data.keys().hasOnly([
              'status', 'templateId', 'templateName', 'timestamp',
              'bodyweight', 'sleepHours', 'durationMin',
              'exercises', 'cardio', 'nextNotes', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasAll(['status', 'timestamp', 'exercises', 'createdAt', 'updatedAt'])
          && (data.status == 'active' || data.status == 'completed')
          && data.timestamp is timestamp
          && data.exercises is list && data.exercises.size() <= 40
          && (!('cardio' in data.keys()) ||
              (data.cardio is list && data.cardio.size() <= 20))
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && (!('templateId' in data.keys()) ||
              (data.templateId is string && data.templateId.size() <= 100))
          && (!('templateName' in data.keys()) ||
              (data.templateName is string && data.templateName.size() <= 100))
          && (!('bodyweight' in data.keys()) ||
              (data.bodyweight is number && data.bodyweight > 0 && data.bodyweight < 1000))
          && (!('sleepHours' in data.keys()) ||
              (data.sleepHours is number && data.sleepHours >= 0 && data.sleepHours <= 24))
          && (!('durationMin' in data.keys()) ||
              (data.durationMin is number && data.durationMin >= 0 && data.durationMin <= 1440))
          && (!('nextNotes' in data.keys()) ||
              (data.nextNotes is string && data.nextNotes.size() <= 2000));
    }

    function hasValidActivityLevel(data) {
      return data.activityLevel == 'sedentary'
          || data.activityLevel == 'light'
          || data.activityLevel == 'moderate'
          || data.activityLevel == 'active'
          || data.activityLevel == 'very_active';
    }

    function hasValidPace(data) {
      // Continuous lb/week in [0, 2] (slider, 0.1 precision). Widened from
      // the old discrete {0,0.5,1,1.5,2} set so a lean cut can sit at e.g.
      // 0.9 lb/wk. Client clamps via clampCutPace; this is the server guard.
      return data.targetPaceLbsPerWeek is number
          && data.targetPaceLbsPerWeek >= 0
          && data.targetPaceLbsPerWeek <= 2;
    }

    function hasValidGoalDirection(data) {
      return data.goalDirection == 'lose'
          || data.goalDirection == 'maintain'
          || data.goalDirection == 'gain';
    }

    function isValidProfileCompleted(data) {
      return data.keys().hasOnly([
              'email', 'createdAt', 'lastSeenAt', 'profileCompleted',
              'heightIn', 'age', 'sex', 'activityLevel',
              'targetPaceLbsPerWeek', 'goalWeightLbs',
              'travelMode', 'fastStartedAt', 'webhookApiKey',
              'fcmToken', 'reminderHour', 'timezoneOffsetMin',
              'ageConfirmedAt', 'preferredLocale', 'welcomeEmailSentAt',
              // v2 2-question onboarding (Q10): heuristic targets +
              // goal direction + onboarding stamp.
              'goalDirection', 'targetWeightLbs',
              'manualCaloriesTarget', 'manualProteinTarget',
              // Whether the two manual* values above are the user's OWN
              // numbers or a computed starting point. See Profile.targetMode
              // in packages/core — the values alone cannot say which, which
              // is why refining used to have to DELETE them.
              'targetMode',
              // Personal protein basis (g/kg), dialed in settings / refine.
              'proteinPerKg',
              // Personal daily-calorie safety floor (kcal), dialed in settings.
              'calorieFloor',
              // Personal daily-protein safety floor (g), dialed in settings.
              'proteinFloor',
              // Continuous activity multiplier derived from the device's own
              // active-energy window, replacing the 5-bucket ladder for the
              // formula estimate. Written only when the user accepts the
              // activity correction; absent means "use activityLevel".
              'activityMultiplier',
              'onboardingV2CompletedAt',
              // Day-3 "Refine targets" stamp.
              'targetsRefinedAt',
              // Day-3 coach push one-shot latch (set by Cloud Function
              // via admin SDK; clients only ever read, never write —
              // but admin-SDK writes still satisfy `hasOnly` so list it).
              'dayThreeCoachPushSent', 'firstEntryAt',
              // Referral attribution + server-stamped reward fields.
              'referredBy', 'compedUntil', 'referralRewardGrantedAt',
              // Public profile (server-stamped by claimPublicSlug).
              'publicSlug', 'publicProfileEnabled', 'publicDisplayName',
              // Weekly digest opt-in. `lastWeeklyDigestSentAt` is
              // server-stamped by sendWeeklyDigest; the rule below
              // pins it immutable to clients.
              'weeklyDigestOptIn', 'lastWeeklyDigestSentAt',
              // Unit system: 'us' (cup/tbsp default) | 'metric' (grams default).
              'unitSystem',
              // Per-user suppress list for the entry-sheet recents row.
              'hiddenRecentLabels',
              // When the user's day starts (ADR-0030). The full history of
              // changes, oldest first — NOT one hour. See the shape check below.
              'dayBoundary',
              // Marks a seeded account (the App Store demo/review logins) so
              // product metrics can exclude it — see functions/src/retention.ts.
              // Written by scripts/seed-demo-account.mjs over the admin SDK;
              // pinned immutable to clients on the update rule below, because a
              // user who could set it would silently remove themselves from
              // every cohort this project measures.
              'syntheticAccount'
          ])
          && hasProfileBase(data)
          && data.profileCompleted == true
          // The v2 2-Q onboarding writes profileCompleted=true with
          // ONLY base + manual targets — no Mifflin-St Jeor inputs
          // (heightIn/age/sex/activityLevel/pace). The Day-3 refine
          // sheet adds those later. So the strict-validation branch
          // only kicks in when those fields are present; the loose
          // branch accepts the v2-only shape.
          && (
            // Strict branch: full Mifflin-St Jeor profile present.
            (
              'heightIn' in data.keys()
              && data.heightIn is number && data.heightIn >= 40 && data.heightIn <= 96
              && data.age is number && data.age >= 13 && data.age <= 120
              && (data.sex == 'male' || data.sex == 'female')
              && hasValidActivityLevel(data)
              && hasValidPace(data)
            )
            // Loose branch: v2 2-Q onboarding only.
            || (
              !('heightIn' in data.keys())
              && 'manualCaloriesTarget' in data.keys()
              && data.manualCaloriesTarget is number
              && data.manualCaloriesTarget > 0
              && data.manualCaloriesTarget < 20000
            )
          )
          && (!('goalDirection' in data.keys()) || hasValidGoalDirection(data))
          && (!('targetWeightLbs' in data.keys()) ||
              (data.targetWeightLbs is number && data.targetWeightLbs > 0 && data.targetWeightLbs < 1000))
          && (!('manualCaloriesTarget' in data.keys()) ||
              (data.manualCaloriesTarget is number && data.manualCaloriesTarget > 0 && data.manualCaloriesTarget < 20000))
          && (!('manualProteinTarget' in data.keys()) ||
              (data.manualProteinTarget is number && data.manualProteinTarget > 0 && data.manualProteinTarget < 1000))
          // Closed set, not a free string: this field decides whether the
          // estimator is overridden, so an unrecognised value must not be
          // storable at all.
          && (!('targetMode' in data.keys()) ||
              data.targetMode in ['auto', 'custom'])
          && (!('proteinPerKg' in data.keys()) ||
              (data.proteinPerKg is number && data.proteinPerKg >= 1.6 && data.proteinPerKg <= 2.2))
          && (!('calorieFloor' in data.keys()) ||
              (data.calorieFloor is number && data.calorieFloor >= 1000 && data.calorieFloor <= 10000))
          // Band mirrors manualProteinTarget above (the widest sane grams
          // range), NOT the narrower stepper bounds the settings UI enforces.
          && (!('proteinFloor' in data.keys()) ||
              (data.proteinFloor is number && data.proteinFloor > 0 && data.proteinFloor < 1000))
          // Band is the FAO/WHO/UNU 2001 PAL range for free-living adults
          // (1.40 sedentary floor .. 2.40 vigorous ceiling), widened a little
          // at both ends so a client clamp change does not need a rules
          // deploy. The app clamps tighter (1.40..1.90); this is the outer
          // sanity bound, not the product rule.
          && (!('activityMultiplier' in data.keys()) ||
              (data.activityMultiplier is number
               && data.activityMultiplier >= 1.0
               && data.activityMultiplier <= 2.5))
          && (!('onboardingV2CompletedAt' in data.keys()) ||
              data.onboardingV2CompletedAt is timestamp)
          && (!('targetsRefinedAt' in data.keys()) ||
              data.targetsRefinedAt is timestamp)
          && (!('firstEntryAt' in data.keys()) ||
              data.firstEntryAt is timestamp)
          && (!('dayThreeCoachPushSent' in data.keys()) ||
              data.dayThreeCoachPushSent is bool)
          && (!('goalWeightLbs' in data.keys()) ||
              (data.goalWeightLbs is number && data.goalWeightLbs > 0 && data.goalWeightLbs < 1000))
          && (!('travelMode' in data.keys()) || data.travelMode is bool)
          && (!('fastStartedAt' in data.keys()) ||
              data.fastStartedAt is timestamp || data.fastStartedAt == null)
          && (!('webhookApiKey' in data.keys()) ||
              (data.webhookApiKey is string && data.webhookApiKey.size() == 36))
          && (!('fcmToken' in data.keys()) ||
              (data.fcmToken is string && data.fcmToken.size() <= 300))
          && (!('reminderHour' in data.keys()) ||
              (data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23))
          && (!('timezoneOffsetMin' in data.keys()) ||
              (data.timezoneOffsetMin is int))
          && (!('ageConfirmedAt' in data.keys()) ||
              data.ageConfirmedAt is timestamp)
          && (!('preferredLocale' in data.keys()) ||
              (data.preferredLocale is string && data.preferredLocale.size() <= 10))
          && (!('welcomeEmailSentAt' in data.keys()) ||
              data.welcomeEmailSentAt is timestamp)
          // Public profile fields. Server-stamped via claimPublicSlug;
          // type checks here defend against malformed direct writes.
          && (!('publicSlug' in data.keys()) ||
              (data.publicSlug is string && data.publicSlug.size() >= 3 && data.publicSlug.size() <= 30))
          && (!('publicProfileEnabled' in data.keys()) ||
              data.publicProfileEnabled is bool)
          && (!('publicDisplayName' in data.keys()) ||
              (data.publicDisplayName is string && data.publicDisplayName.size() <= 40))
          // Weekly digest. `weeklyDigestOptIn` is client-writable; the
          // `lastWeeklyDigestSentAt` latch is server-only (immutability
          // enforced separately on the update rule).
          && (!('weeklyDigestOptIn' in data.keys()) ||
              data.weeklyDigestOptIn is bool)
          && (!('lastWeeklyDigestSentAt' in data.keys()) ||
              data.lastWeeklyDigestSentAt is timestamp)
          && (!('unitSystem' in data.keys()) ||
              data.unitSystem == 'us' || data.unitSystem == 'metric')
          && (!('hiddenRecentLabels' in data.keys()) ||
              (data.hiddenRecentLabels is list
               && data.hiddenRecentLabels.size() <= 200))
          // Day boundary (ADR-0030): a list of {from, hour} changes, oldest
          // first. Rules cannot ITERATE a list, so the per-element shape is
          // genuinely not checkable here — only the container and a sane cap
          // are. `dayBoundaryOf` in packages/core is therefore written to
          // sanitize rather than trust: it drops any entry that is not a
          // {from: YYYY-MM-DD, hour: 0..6} and re-sorts, so a hand-crafted
          // write that gets past this cannot reach the estimator as garbage.
          // The cap is 24 because a boundary is a setting somebody changes
          // once or twice, and an unbounded append-only list on a doc read on
          // every app open is a cost problem before it is a correctness one.
          && (!('dayBoundary' in data.keys()) ||
              (data.dayBoundary is list
               && data.dayBoundary.size() <= 24))
          && (!('syntheticAccount' in data.keys()) ||
              data.syntheticAccount is bool);
    }

    function isValidProfile(data) {
      return isValidProfileInitial(data) || isValidProfileCompleted(data);
    }

    // ─── Per-user subtree ───────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isVerifiedUser() && isValidProfile(request.resource.data)
                       // `syntheticAccount` is listed in both profile
                       // validators so a seeded account stays editable, but
                       // it is admin-SDK-only: a client that could set it at
                       // CREATE time would self-exclude from every product
                       // metric permanently, and the update rule below would
                       // then freeze that choice in place. Pinning it on
                       // update alone left exactly that hole.
                       && !('syntheticAccount' in request.resource.data.keys());
      allow update: if isOwner(uid) && isValidProfile(request.resource.data)
                       // Referral fields are immutable from the client:
                       //   - `referredBy` is set once on profile create
                       //     and represents an audit trail. Letting users
                       //     edit it post-create would let them re-claim
                       //     a reward by switching referrers.
                       //   - `compedUntil` and `referralRewardGrantedAt`
                       //     are server-stamped by the onSubscriptionWritten
                       //     trigger via admin SDK (which bypasses rules).
                       //     A client write here = unauthorized self-grant.
                       && (resource.data.get('referredBy', null) ==
                           request.resource.data.get('referredBy', null))
                       && (resource.data.get('compedUntil', null) ==
                           request.resource.data.get('compedUntil', null))
                       && (resource.data.get('referralRewardGrantedAt', null) ==
                           request.resource.data.get('referralRewardGrantedAt', null))
                       // publicSlug + publicProfileEnabled are server-only
                       // (set by claimPublicSlug / releasePublicSlug). A
                       // direct client write here would let users grab any
                       // slug bypassing uniqueness checks.
                       && (resource.data.get('publicSlug', null) ==
                           request.resource.data.get('publicSlug', null))
                       && (resource.data.get('publicProfileEnabled', null) ==
                           request.resource.data.get('publicProfileEnabled', null))
                       // lastWeeklyDigestSentAt is server-stamped by
                       // sendWeeklyDigest; clients read but cannot reset
                       // it (which would cause duplicate sends).
                       && (resource.data.get('lastWeeklyDigestSentAt', null) ==
                           request.resource.data.get('lastWeeklyDigestSentAt', null))
                       // Server-only notification/lifecycle latches (all
                       // written by admin-SDK CFs: dayThreeCoachPushSent by
                       // sendDayThreeCoachPush, welcomeEmailSentAt by
                       // sendWelcomeEmail, firstEntryAt by onDailyLogCreated).
                       // Clients read them but must not set/flip them, else a
                       // user could suppress their own day-3 nudge / welcome
                       // email or forge activation metrics.
                       // (ageConfirmedAt / onboardingV2CompletedAt /
                       // targetsRefinedAt are deliberately NOT pinned — those
                       // are legitimately client-stamped.)
                       && (resource.data.get('dayThreeCoachPushSent', null) ==
                           request.resource.data.get('dayThreeCoachPushSent', null))
                       && (resource.data.get('welcomeEmailSentAt', null) ==
                           request.resource.data.get('welcomeEmailSentAt', null))
                       && (resource.data.get('firstEntryAt', null) ==
                           request.resource.data.get('firstEntryAt', null))
                       // `syntheticAccount` marks the seeded demo/review
                       // logins so retention cohorts can drop them. It is a
                       // measurement flag, not a user setting: a client that
                       // could set it would delete itself from every product
                       // metric, and one that could clear it would put the
                       // seeded 83-log account back into the numbers.
                       && (resource.data.get('syntheticAccount', null) ==
                           request.resource.data.get('syntheticAccount', null));

      match /dailyLogs/{logId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidLog(request.resource.data);
        allow update: if isOwner(uid) && isValidLog(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // In-app feedback — append-only from the client. The owner reads it
      // through the admin panel's collectionGroup query (see the
      // /{path=**}/feedback rule further down); the reporter cannot read
      // even their own, which is deliberate: there is no in-app inbox, and a
      // readable copy would imply one.
      match /feedback/{feedbackId} {
        allow read:   if isAdmin();
        allow create: if isOwner(uid) && isValidFeedback(request.resource.data);
        allow update, delete: if false;
      }

      // Third-party integration status — Oura today, others later.
      //
      // Owner-readable, SERVER-WRITTEN. The client needs to render
      // "Connected since <date>" and a Disconnect button, and this is the
      // only part of the link it is allowed to see.
      //
      // The credential itself lives at `users/{uid}/private/oura`, which
      // matches NO rule in this file and is therefore denied by the
      // `match /{document=**}` catch-all at the bottom. Do NOT add a match
      // block for `private/**` — the absence of one IS the access control
      // for the refresh token, and `firestore-rules.spec.ts` asserts the
      // deny so this cannot regress silently.
      //
      // Writes are server-only (`beginOuraLink` / `ouraCallback` /
      // `unlinkOura` via the Admin SDK, which bypasses rules). A client
      // that could write here could claim to be connected without a token,
      // or forge `connectedAt`.
      match /integrations/{provider} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // Meal presets — quick-add templates.
      match /presets/{presetId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidPreset(request.resource.data);
        allow update: if isOwner(uid) && isValidPreset(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Custom foods — the My Foods library (ADR-0013). Portionable,
      // barcode-keyed foods saved from a scan / label OCR / text resolve.
      match /customFoods/{foodId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidCustomFood(request.resource.data);
        allow update: if isOwner(uid) && isValidCustomFood(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Daily weights — one weight per calendar day.
      // The doc id IS the date key (YYYY-MM-DD). The VALUE was bounded here
      // but the DATE never was, so a mistyped year could plant a weigh-in
      // decades from the rest of the series — and the measured-TDEE window is
      // bounded by entry count, not by calendar date, so such a row stays in
      // the regression indefinitely with maximum leverage on the slope.
      // String comparison is date comparison for YYYY-MM-DD. Mirrors
      // WEIGH_IN_MIN_DATE_KEY / isStorableWeighInDate in packages/core.
      match /dailyWeights/{dateKey} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isOwner(uid)
            && isPlausibleWeighInDateKey(dateKey)
            && request.resource.data.keys().hasAll(['weight'])
            && request.resource.data.keys().hasOnly(['weight'])
            && request.resource.data.weight is number
            && request.resource.data.weight > 0
            && request.resource.data.weight < 1000;
      }

      // Daily water intake — one doc per calendar day keyed by date.
      // Stored in US fluid ounces ({ flOz }) as the single source of
      // truth. Upper bound of 676 fl oz is ~5 gallons — implausible but
      // catches fat-finger data that would otherwise pollute charts.
      //
      // Legacy { ml } writes (≤ 20_000 ml ≈ 5 gal) are still accepted so
      // app clients cached from before the 2026-06 unit migration keep
      // working until they refresh. Drop the ml branch once they have.
      match /dailyWater/{dateKey} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isOwner(uid)
            && (
              (request.resource.data.keys().hasOnly(['flOz'])
                && request.resource.data.flOz is number
                && request.resource.data.flOz >= 0
                && request.resource.data.flOz <= 676)
              || (request.resource.data.keys().hasOnly(['ml'])
                && request.resource.data.ml is number
                && request.resource.data.ml >= 0
                && request.resource.data.ml <= 20000)
            );
      }

      // Daily sleep — hours slept, one doc per calendar day keyed by date,
      // shape { hours, source? }. Canonical record; the Train session sheet's
      // sleep mirrors here on finish. Range [0, 24].
      //
      // `source` distinguishes a number the USER typed from one an importer
      // (Apple Health / Health Connect / Oura) wrote, so an automatic import
      // can decline to overwrite a manual entry. It is OPTIONAL because every
      // document written before 2026-08-24 lacks it; the client treats a
      // missing source as 'manual', which protects existing hand-entered
      // nights rather than assuming they are disposable.
      //
      // The enum is enforced here rather than trusted: this is the only
      // access-control layer there is, and a free-form string would let a
      // client write `source: 'manual'` from an importer and defeat the point.
      match /dailySleep/{dateKey} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isOwner(uid)
            && request.resource.data.keys().hasOnly(['hours', 'source'])
            && request.resource.data.hours is number
            && request.resource.data.hours >= 0
            && request.resource.data.hours <= 24
            && (!('source' in request.resource.data.keys())
                || request.resource.data.source in ['manual', 'import']);
      }

      // Daily activity — steps + active energy imported FROM the OS health
      // store (Apple Health / Health Connect). One doc per calendar day,
      // shape { steps?, activeKcal? }; both fields optional because the two
      // importers write independently and merge into the same doc, so a day
      // can legitimately carry either one alone.
      //
      // Import-only: the device measures these and the app never writes them
      // back to Health. Bounds mirror STEPS_MAX / ACTIVE_ENERGY_MAX_KCAL in
      // packages/core/src/health-mapping.ts — keep the two in step.
      match /dailyActivity/{dateKey} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isOwner(uid)
            && request.resource.data.keys().hasOnly(['steps', 'activeKcal'])
            && (!('steps' in request.resource.data)
              || (request.resource.data.steps is number
                && request.resource.data.steps >= 0
                && request.resource.data.steps <= 200000))
            && (!('activeKcal' in request.resource.data)
              || (request.resource.data.activeKcal is number
                && request.resource.data.activeKcal >= 0
                && request.resource.data.activeKcal <= 20000));
      }

      // Body measurements — weekly/biweekly body-comp tracking.
      match /measurements/{measurementId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidMeasurement(request.resource.data);
        allow update: if isOwner(uid) && isValidMeasurement(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ─── Train tab (workout logging) ──────────────────────────
      // Per-user exercise catalog — the stable identity progression
      // charts aggregate over.
      match /exercises/{exerciseId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidExercise(request.resource.data);
        allow update: if isOwner(uid) && isValidExercise(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Editable workout templates (blueprints).
      match /workoutTemplates/{templateId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidWorkoutTemplate(request.resource.data);
        allow update: if isOwner(uid) && isValidWorkoutTemplate(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Logged sessions (snapshots). Live-written set-by-set while the
      // workout is in progress (status:'active') then flipped to
      // 'completed' on finish.
      match /workoutSessions/{sessionId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidWorkoutSession(request.resource.data);
        allow update: if isOwner(uid) && isValidWorkoutSession(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Weekly AI reports — cached markdown.
      // Writes are server-only: the `generateWeeklyReport` Cloud Function
      // enforces the Pro gate + rate limit and writes via admin SDK,
      // which bypasses these rules. Clients never create report docs.
      match /reports/{reportId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if false;
        allow delete: if isOwner(uid);
      }
    }

    // ─── Admin-facing collections ─────────────────────────────────
    // Audit log: written server-side via admin SDK; admins can read
    // from the client to render the audit tab. No client writes ever.
    match /auditLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ─── Server-side config ─────────────────────────────────────
    // Writes are still server-only (all admin mutations go through the
    // admin-ops Cloud Functions so everything is audited). Admins get
    // client read access so the admin panel can render the admins /
    // comped-friends / stats tabs without extra round-trips.
    match /config/{doc} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ─── Consultation quota (AI coach rate limit) ───────────────
    // Written by the consultationStream Cloud Function via the admin SDK
    // (which bypasses these rules), so writes stay denied outright — a
    // client-writable counter is a free-consultations primitive.
    //
    // READS are scoped to the caller's OWN doc, added 2026-08-09. Doc ids are
    // `<uid>_<YYYY-MM-DD>`, so the uid prefix is the tenant key and this
    // leaks nothing across users — the previous blanket deny existed to stop
    // doc-id guessing, which a uid check stops just as well.
    //
    // It exists because the count reached the client ONLY in a consultation's
    // response, so a user could not see how many they had left until they
    // spent one — an allowance you cannot check until you use it. Reading a
    // number the server already maintains costs one document read on opening
    // Coach, and no new Cloud Function.
    match /consultationQuota/{quotaId} {
      allow read:  if isOwner(quotaId.split('_')[0]);
      allow write: if false;
    }

    // ─── Org-wide spend ceiling + kill-switch ───────────────────
    // Written by the AI callables via the admin SDK (which bypasses
    // these rules) and by the adminSetSpendCeiling callable. Denied
    // to clients outright, including admins: unlike /config, which
    // admins read directly to render panel tabs, this doc is BOTH a
    // counter on a hot path and a switch that turns a feature off for
    // every user. A client-writable kill-switch is a denial-of-service
    // primitive, and a client-writable counter lets anyone zero the
    // meter and spend past the ceiling. The admin panel reads it
    // through adminGetSpendCeilings, so every change is audited.
    match /opsBudget/{kind} {
      allow read, write: if false;
    }

    // ─── Password-reset rate limit ──────────────────────────────
    // Written by the sendPasswordReset Cloud Function via the admin
    // SDK (which bypasses these rules). The caller is UNAUTHENTICATED
    // by necessity, so client access must be denied outright: a
    // readable counter would confirm which addresses have requested a
    // reset (an enumeration oracle), and a writable one would let an
    // attacker reset the window and bypass the limit entirely.
    // Doc ids are salt-free SHA-256 tags, never plaintext addresses.
    match /emailRateLimits/{limitId} {
      allow read, write: if false;
    }

    // ─── Stripe Firebase Extension ───────────────────────────────
    // Managed by ext: firestore-stripe-payments.
    // The extension writes customer/subscription/payment records
    // under customers/{uid}. Products + prices are catalog data
    // readable by any signed-in user so they can render the price.
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid) || isAdmin();
      }
      match /payments/{id} {
        allow read: if isOwner(uid) || isAdmin();
      }
    }

    match /products/{id} {
      allow read: if request.auth != null;

      match /prices/{priceId} {
        allow read: if request.auth != null;
      }
      match /tax_rates/{taxId} {
        allow read: if request.auth != null;
      }
    }

    // ─── Public status heartbeat ────────────────────────────────
    // Written every few minutes by the `statusPulse` scheduled
    // Cloud Function (via admin SDK). The /status public page reads
    // this doc to decide the health indicator, so we allow unauth
    // reads. Writes stay server-only — no `allow write` means the
    // admin SDK path is the only way to update.
    match /status/{doc} {
      allow read: if true;
    }

    // Public stats doc (landing social proof). Written by a scheduled
    // Cloud Function via the admin SDK; readable by anyone so the
    // marketing landing can render the count without requiring auth.
    match /public/{doc} {
      allow read: if true;
    }

    // Public profile mirrors (`/u/<slug>`). Public-readable so the SPA
    // can render a transformation page without auth. Writes are blocked
    // for clients — the `onUserUpdateMirrorPublicProfile` trigger and
    // the `claimPublicSlug` callable are the only writers.
    match /publicProfiles/{slug} {
      allow read: if true;
    }
    // Slug-uniqueness ledger. Owned exclusively by `claimPublicSlug` /
    // `releasePublicSlug` callables; clients never read or write here.
    match /publicSlugs/{slug} {
      allow read, write: if false;
    }

    // ─── Product analytics: per-user, per-day counters ──────────
    //
    // One doc per user per day, `usageEvents/<uid>_<YYYY-MM-DD>`, holding
    // integer counts and nothing else. The catalogue is closed and enumerated
    // below deliberately: `@macrolog/core/usage-events` is the other copy, and
    // adding an event has to happen in both places. That friction is the point
    // — it is what keeps this a counter and stops it becoming a behavioural log.
    //
    // Client-WRITABLE, unlike every other counter in this file, and the reason
    // is worth stating because the precedent above points the other way.
    // `consultationQuota` and `opsBudget` are deny-write because they are
    // *enforcement* — a client that can zero the meter spends past the ceiling,
    // which costs money. These counters enforce nothing and gate nothing. The
    // only thing a user can do by forging them is misreport their own usage,
    // which the uid scoping already confines to their own row. The alternative
    // — a Cloud Function per event — would spend real money to protect a number
    // whose worst-case abuse is a skewed chart, and CLAUDE.md's cost discipline
    // says not to.
    //
    // What the rules still hold: the tenant key (uid prefix), the doc id
    // matching the day, a closed field set, non-negative ints under a hard cap,
    // and immutability of the identity fields once written.
    function usageEventFields() {
      return [
        'app_open', 'signup', 'onboarding_complete', 'log_added',
        'log_queued_offline', 'repeat_yesterday', 'quick_add', 'photo_scan',
        'barcode_scan', 'voice_log', 'coach_ask', 'weight_logged',
        'workout_finished',
      ];
    }

    // A counter is absent, or an int in [0, 2000]. Absent is the normal case:
    // the client flushes a merge carrying only the events that happened.
    function validUsageCount(d, field) {
      return !(field in d) || (d[field] is int && d[field] >= 0 && d[field] <= 2000);
    }

    function validUsageDoc(d, docId) {
      return d.keys().hasOnly(usageEventFields().concat(['uid', 'day', 'platform', 'updatedAt']))
        && d.uid is string
        && d.uid == request.auth.uid
        // The day is in the doc id, so a client cannot spread one day's
        // activity across a month of documents or backfill a streak.
        && d.day is string
        && docId == d.uid + '_' + d.day
        && d.platform in ['web', 'ios', 'android']
        && d.updatedAt == request.time
        && validUsageCount(d, 'app_open')
        && validUsageCount(d, 'signup')
        && validUsageCount(d, 'onboarding_complete')
        && validUsageCount(d, 'log_added')
        && validUsageCount(d, 'log_queued_offline')
        && validUsageCount(d, 'repeat_yesterday')
        && validUsageCount(d, 'quick_add')
        && validUsageCount(d, 'photo_scan')
        && validUsageCount(d, 'barcode_scan')
        && validUsageCount(d, 'voice_log')
        && validUsageCount(d, 'coach_ask')
        && validUsageCount(d, 'weight_logged')
        && validUsageCount(d, 'workout_finished');
    }

    match /usageEvents/{eventId} {
      // Own row only — same uid-prefix tenancy as consultationQuota.
      allow read: if isOwner(eventId.split('_')[0]);
      allow create: if isOwner(eventId.split('_')[0])
        && validUsageDoc(request.resource.data, eventId);
      // `uid` and `day` are identity, not data: letting an update move them
      // would let one day's doc be re-pointed at another day after the fact.
      allow update: if isOwner(eventId.split('_')[0])
        && validUsageDoc(request.resource.data, eventId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.day == resource.data.day;
      // Deletion is the account-deletion path, which runs in the admin SDK and
      // bypasses these rules. A client deleting its own counters is harmless
      // but pointless, and denying it keeps the surface minimal.
      allow delete: if false;
    }

    // Admin-only collectionGroup read over every user's feedback. The
    // per-user rule above cannot serve this: a collectionGroup query is
    // evaluated against a rule matched on the COLLECTION ID, not on the
    // document path, so without this block the admin panel's query fails
    // even though the admin can read each document individually.
    match /{path=**}/feedback/{feedbackId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
