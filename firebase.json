{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "extensions": {
    "firestore-stripe-payments": "invertase/firestore-stripe-payments@0.3.11"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "site": "macrolog",
      "public": "dist/fitness-tracker-pwa/browser",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/*.map"
      ],
      "redirects": [
        {
          "source": "/tip",
          "destination": "/support",
          "type": 302
        },
        {
          "_comment": "Every weekly-recap email ever sent links its 'Open your log' button here (APP_LINK in functions/src/email-templates.ts). The redirector it describes was never built: hosting served index.html via the ** rewrite, detectRoute() in src/app/app.ts had no /open case, and the SPA rendered its branded 404 — a 200 that looks like a 404 to the reader. Fixing the template alone would only help FUTURE mail, so the URL itself has to resolve. /app is the real entry point; the auth gate decides log vs sign-in from there.",
          "source": "/open",
          "destination": "/app",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "/og/u/**",
          "function": {
            "functionId": "ogImagePublicProfile",
            "region": "us-central1"
          }
        },
        {
          "source": "/u/**",
          "function": {
            "functionId": "servePublicProfilePage",
            "region": "us-central1"
          }
        },
        {
          "source": "/unsubscribe",
          "function": {
            "functionId": "unsubscribeWeeklyDigest",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            }
          ]
        },
        {
          "source": "**/*.@(js|mjs|css|woff2|woff|ttf|otf|png|svg|jpg|jpeg|webp|gif|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/ngsw-worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/ngsw.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            }
          ]
        }
      ],
      "appAssociation": "NONE"
    }
  ]
}
